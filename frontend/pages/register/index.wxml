<view class="page">
  <view class="field">
    <text class="label">昵称</text>
    <input class="input" placeholder="1-32 个字符" maxlength="32" value="{{nickname}}" bindinput="onNicknameInput" />
  </view>

  <view class="field">
    <text class="label">兴趣标签</text>
    <input class="input" placeholder="用逗号分隔，最多 5 个" value="{{tags}}" bindinput="onTagsInput" />
  </view>

  <button class="btn" bindtap="submit">保存</button>
</view>
