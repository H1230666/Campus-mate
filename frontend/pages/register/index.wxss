.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding: 32rpx;
  box-sizing: border-box;
}

.field {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  font-size: 30rpx;
  color: #222;
}

.btn {
  margin-top: 40rpx;
  border-radius: 999rpx;
  background: #2f6bff;
  color: #fff;
  font-size: 30rpx;
}
