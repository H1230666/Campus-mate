.filter-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.filter-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background-color: #fff;
  color: #555;
}

.filter-item.active {
  background-color: #2b6de8;
  color: #fff;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
}

.card-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.card-status.recruiting {
  color: #1a7f37;
  background-color: #e6f4ea;
}

.card-status.full {
  color: #999;
  background-color: #f0f0f0;
}

.card-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
  color: #777;
  font-size: 26rpx;
}

.tag {
  color: #2b6de8;
}

.state-more {
  padding: 40rpx 0;
}

.publish-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  padding: 20rpx 36rpx;
  border-radius: 48rpx;
  background-color: #2b6de8;
  color: #fff;
  font-size: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 109, 232, 0.3);
  z-index: 10;
}
