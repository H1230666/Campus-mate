.page-wrap {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #cce0ff 0%, #f0ecff 100%);
  padding: 120rpx 40rpx 60rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.header {
  text-align: center;
  margin-bottom: 100rpx;
}
.logo-icon {
  font-size: 100rpx;
  color: #7b68ee;
  margin-bottom: 16rpx;
}
.title {
  font-size: 60rpx;
  font-weight: bold;
  color: #333344;
}
.slogan {
  font-size: 30rpx;
  color: #6b6299;
  margin-top: 12rpx;
  font-style: italic;
}

.form-box {
  width: 100%;
}
.input-item {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.75);
  border-radius: 999rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.input-item .icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  color: #7b68ee;
}
.input {
  flex: 1;
  font-size: 30rpx;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(90deg, #7b68ee, #9381f0);
  color: #fff;
  border-radius: 999rpx;
  font-size: 34rpx;
  padding: 30rpx 0;
  margin: 30rpx 0;
  border: none;
}
.submit-btn::after {
  border: none;
}

.row-line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 50rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}
.divider .line {
  flex: 1;
  height: 1rpx;
  background-color: #ccc;
}
.div-text {
  font-size: 26rpx;
  color: #888;
  margin: 0 20rpx;
}

.wechat-login {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 60rpx;
}
.wechat-icon {
  font-size: 44rpx;
  color: #7b68ee;
}

.agree-box {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #555;
}
.link {
  color: #7b68ee;
}

.wave-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 140rpx;
  background: linear-gradient(180deg, transparent, #dcd4fa);
  border-radius: 100% 100% 0 0;
  z-index: 0;
}
