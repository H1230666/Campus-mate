<view class="page-wrap">
  <!-- 顶部图标+标题 -->
  <view class="header">
    <view class="logo-icon">👥</view>
    <view class="title">校园搭子</view>
    <view class="slogan">在校园，遇见更好的搭子！</view>
  </view>

  <!-- 表单区域 -->
  <view class="form-box">
    <view class="input-item">
      <view class="icon">👤</view>
      <input class="input" placeholder="请输入学号/手机号" bindinput="onAccountInput" value="{{account}}"/>
    </view>
    <view class="input-item">
      <view class="icon">🔒</view>
      <input class="input" placeholder="请输入密码" password bindinput="onPwdInput" value="{{pwd}}"/>
    </view>

    <button class="submit-btn" bindtap="accountLogin">登录</button>

    <view class="row-line">
      <text class="left-tip">验证码登录</text>
      <text class="right-tip">忘记密码？</text>
    </view>

    <view class="divider">
      <view class="line"></view>
      <text class="div-text">其他登录方式</text>
      <view class="line"></view>
    </view>

    <!-- 微信一键登录 -->
    <view class="wechat-login" bindtap="handleLogin">
      <view class="wechat-icon">💬</view>
    </view>

    <view class="agree-box">
      <checkbox checked="{{isAgree}}" bindtap="toggleAgree"/>
      <text>我已阅读并同意<text class="link">《用户协议》</text>和<text class="link">《隐私政策》</text></text>
    </view>
  </view>

  <!-- 底部波浪装饰 -->
  <view class="wave-bottom"></view>
</view>
