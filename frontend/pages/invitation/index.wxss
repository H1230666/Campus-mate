.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.label {
  color: #999;
}

.desc {
  margin-top: 24rpx;
  color: #555;
  line-height: 1.6;
}
