.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #eef0f6;
  display: block;
  margin: 0 auto 24rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  color: #222;
}

.openid {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  word-break: break-all;
}

.section-title {
  margin: 40rpx 0 16rpx;
  font-size: 28rpx;
  color: #666;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 8rpx 24rpx;
  background: #eef4ff;
  color: #2f6bff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.tag.empty {
  background: #f1f2f5;
  color: #999;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
}

.actions {
  margin-top: 48rpx;
}

.btn {
  margin-bottom: 24rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  background: #fff;
  color: #333;
}

.btn.primary {
  background: #2f6bff;
  color: #fff;
}
