<view class="page">
  <view class="card" wx:if="{{!loading}}">
    <image class="avatar" wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill"></image>
    <view class="avatar avatar-empty" wx:else style="width:120rpx;height:120rpx;line-height:120rpx;text-align:center;border-radius:50%;background:#f2f3f5;color:#9aa0a6;font-size:24rpx;">搭子</view>
    <view class="nickname">{{nickname}}</view>
    <view class="openid">openid：{{openid}}</view>

    <view class="section-title">兴趣标签</view>
    <view class="tags">
      <text class="tag" wx:for="{{tags}}" wx:key="*this">{{item}}</text>
      <text class="tag empty" wx:if="{{tags.length === 0}}">还没有标签</text>
    </view>
  </view>

  <view class="loading" wx:else>加载中…</view>

  <view class="actions">
    <button class="btn primary" bindtap="goEdit">编辑资料</button>
    <button class="btn" bindtap="logout">退出登录</button>
  </view>
</view>
